{
  "name": "hamsakht-platform",
  "version": "3.1.0",
  "description": "پلتفرم جامع و سبک مدیریت سبد پروژه‌ها، مشارکت، سرمایه، عملکرد مالی و حاکمیت",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "npm run test:backend && npm run test:e2e",
    "test:backend": "node --test \"test/backend/*.test.js\"",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/lighthouse.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "notification:manual": "node scripts/manual-notification.js",
    "hash-password": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "chrome-launcher": "^1.0.0",
    "lighthouse": "^13.4.1"
  }
}
