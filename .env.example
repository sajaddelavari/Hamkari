# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://example.com
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
# DATABASE_PATH=/app/data/hamkari.db
# HAMSAKHT_IMAGE=registry.example.com/hamsakht@sha256:replace-with-release-digest

# Keep false when Node is reached directly. Behind a reverse proxy, list only
# that proxy's IP/CIDR ranges (comma-separated), for example: 172.16.0.0/12
# The broad value "true" is intentionally rejected in production.
TRUST_PROXY=false

# Generate with: npm run hash-password
# Keep the single quotes: Docker Compose would otherwise expand the "$" parts.
ADMIN_PASSWORD_HASH='scrypt$16384$8$1$replace-with-salt$replace-with-hash'

# Generate each value independently, for example by running this command three
# times: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Production refuses missing, reused, short, or placeholder values.
SESSION_SECRET=replace-with-independent-random-session-secret
AUTH_ENCRYPTION_KEY=replace-with-independent-random-encryption-key
AUDIT_HMAC_KEY=replace-with-independent-random-audit-key

# Versioned documents are stored in SQLite and included in normal backups.
UPLOAD_LIMIT_BYTES=5242880
DOCUMENT_PROJECT_QUOTA_BYTES=268435456
DOCUMENT_ORGANIZATION_QUOTA_BYTES=1073741824
DOCUMENT_MAX_VERSIONS=100
DOCUMENT_UPLOADS_PER_HOUR=30

# Safe defaults never claim that an external delivery or payment succeeded.
# Notification sandbox is development-only. Payment sandbox is also rejected in
# production; production remains manual until a verified live adapter is installed.
NOTIFICATION_PROVIDER=manual
PAYMENT_PROVIDER_MODE=manual
# Must remain true in production.
DISTRIBUTION_KYC_REQUIRED=true

# SQLite contention settings for a single-server deployment.
SQLITE_BUSY_TIMEOUT_MS=5000
